{
  "name": "react-media-kit",
  "version": "1.0.0",
  "description": "A collection of React hooks for capturing, recording, and streaming audio and video using browser media APIs and WebRTC.",
  "keywords": [
    "react",
    "typescript",
    "media",
    "camera",
    "microphone",
    "recording",
    "webrtc"
  ],
  "license": "MIT",
  "author": "Ibrahim Adeosun",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1"
  }
}
