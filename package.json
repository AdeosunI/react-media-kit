{
  "name": "@adeosuni/react-media-kit",
  "version": "1.0.0-beta.2",
  "description": "A collection of React hooks for capturing, recording, and streaming audio and video using browser media APIs and WebRTC.",
  "keywords": [
    "react",
    "typescript",
    "media",
    "camera",
    "microphone",
    "recording",
    "webrtc"
  ],
  "license": "MIT",
  "author": "Ibrahim Adeosun",
  "repository": {
    "type": "git",
    "url": "https://github.com/AdeosunI/react-media-kit.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "recorder-demo": "npm run dev -w recorder-demo",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "publishConfig": {
    "@adeosuni:registry": "https://npm.pkg.github.com"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "src"
  ]
}
